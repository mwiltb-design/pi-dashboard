{
  "name": "pi-dashboard-desktop",
  "version": "1.0.0-alpha.4",
  "description": "Standalone cross-platform desktop dashboard for Pi coding agent",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "server",
    "ui",
    "electron"
  ],
  "scripts": {
    "start": "npm --prefix electron start",
    "dev:server": "npm --prefix server run dev",
    "dev:ui": "npm --prefix ui run dev",
    "build": "npm --prefix server run build && npm --prefix ui run build",
    "dist:windows": "npm run build && electron-builder --win",
    "icons:mac": "bash scripts/generate-icons-mac.sh",
    "dist:mac": "npm run build && npm run icons:mac && electron-builder --mac --universal --config.npmRebuild=true"
  },
  "keywords": [
    "pi",
    "ai",
    "dashboard",
    "desktop",
    "electron",
    "developer-tools"
  ],
  "author": "mwiltb-design",
  "license": "GPL-3.0",
  "homepage": "https://focidashboard.dev",
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.13",
    "electron-builder": "^26.15.3"
  }
}
